#!/bin/bash

# --- 設定項目 ---
BACKUP_DIR="$HOME/.sandbox_backup"
LOG_DIR="$HOME/.sandbox_logs"
TRASH_CMD="trash-put" 
THRESHOLD=5          # プレビューを強制するファイル数の閾値（より厳格に）
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG_FILE="$LOG_DIR/sandbox_session_$TIMESTAMP.log"

# 準備
mkdir -p "$BACKUP_DIR"
mkdir -p "$LOG_DIR"

# --- 安全な実行のための関数定義 ---

# 1. プレビュー機能付き rm
strict_rm() {
    local files=("$@")
    local count=${#files[@]}
    
    if [ $count -eq 0 ]; then command rm; return; fi

    # プレビュー表示（機能 1）
    echo "🔍 [Preview] 以下の $count 個の項目を操作しようとしています:"
    ls -F -d "${files[@]}" | sed 's/^/  /'
    
    if [ $count -gt $THRESHOLD ] || [[ "$*" == *"/etc/"* ]] || [[ "$*" == *"/boot/"* ]]; then
        echo "⚠️  [Strict] 重要なパス、または多数のファイルが選択されています。"
    fi
    
    read -p "🗑️  ゴミ箱へ移動しますか？ (y/n): " confirm
    if [[ "$confirm" != "y" ]]; then
        echo "キャンセルしました。"
        return 1
    fi

    if command -v $TRASH_CMD &> /dev/null; then
        $TRASH_CMD "${files[@]}"
        echo "♻️  Done."
    else
        echo "⚠️  trash-cli未検出。'rm -i' で実行します。"
        command rm -i "${files[@]}"
    fi
}

# システム保護 & バックアップ
strict_write() {
    local cmd=$1
    shift
    local files=("$@")
    local target="${@: -1}"

    if [[ "$target" == "/etc"* ]] || [[ "$target" == "/boot"* ]] || [[ "$target" == "/usr"* ]]; then
        echo "🚫 [Error] システム領域への書き込みは禁止されています。"
        return 1
    fi

    echo "📦 [Backup] $BACKUP_DIR へコピーをとります..."
    cp -r "${files[@]}" "$BACKUP_DIR/" 2>/dev/null
    
    command $cmd "${files[@]}"
}

# --- メイン処理 ---

echo "🛡️  Entering Sandbox Mode..."
echo "📝 本セッションのログは以下に保存されます:"
echo "   $LOG_FILE"
echo "💡 終了するには 'exit' と入力してください。"

# 関数と変数をエクスポート
export -f strict_rm
export -f strict_write
export BACKUP_DIR THRESHOLD TRASH_CMD

# 機能 5: scriptコマンドで入出力をすべて記録
# -q: 静かに起動, -c: 実行するコマンドを指定
script -q -c "bash --rcfile <(cat <<EOF
    [ -f ~/.bashrc ] && . ~/.bashrc
    alias rm='strict_rm'
    alias mv='strict_write mv'
    alias cp='strict_write cp'
    alias apt='echo \"🚫 Sandbox内でのパッケージ操作は禁止されています\"'
    export PS1=\"[📦sandbox] \\\$PS1\"
EOF
)" "$LOG_FILE"

echo "👋 Sandbox終了。ログを保存しました。"
